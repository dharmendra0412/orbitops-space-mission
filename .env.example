# Optional: set the separately hosted FastAPI origin for production frontend builds.
# Leave empty for local development, where Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# Backend: comma-separated exact frontend origins allowed to call the API from a browser.
# Example: https://orbitops.example.com
ORBITOPS_CORS_ORIGINS=

# Host port for the self-hosted Docker Compose website.
ORBITOPS_WEB_PORT=8080

# Never commit real API keys, tokens, or database credentials.
